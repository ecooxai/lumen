if(NOT ANDROID_NDK)
    set(ANDROID_NDK "${CMAKE_ANDROID_NDK}")
endif()
if(NOT EXISTS "${ANDROID_NDK}/build/cmake/android.toolchain.cmake")
    message(FATAL_ERROR "Provide ANDROID_NDK for the Android V8 toolchain")
endif()
if(NOT LUMEN_V8_COMPILER_DIR)
    set(LUMEN_V8_COMPILER_DIR "${LUMEN_V8_DIR}/third_party/llvm-build/Release+Asserts/bin")
endif()
if(NOT EXISTS "${LUMEN_V8_COMPILER_DIR}/clang++")
    message(FATAL_ERROR "Provide LUMEN_V8_COMPILER_DIR or LUMEN_V8_DIR with the verified Clang compiler")
endif()

include("${ANDROID_NDK}/build/cmake/android.toolchain.cmake")
if(NOT ANDROID_NDK_REVISION STREQUAL "28.2.13676358")
    message(FATAL_ERROR "Android V8 requires the pinned NDK r28c (28.2.13676358)")
endif()
if(ANDROID_ABI STREQUAL "arm64-v8a")
    set(lumen_runtime_arch aarch64)
elseif(ANDROID_ABI STREQUAL "x86_64")
    set(lumen_runtime_arch x86_64)
else()
    message(FATAL_ERROR "Android V8 supports arm64-v8a or x86_64")
endif()
execute_process(COMMAND "${ANDROID_C_COMPILER}" --print-resource-dir
    RESULT_VARIABLE lumen_resource_status OUTPUT_VARIABLE lumen_ndk_resource
    OUTPUT_STRIP_TRAILING_WHITESPACE)
set(lumen_runtime_dir "${lumen_ndk_resource}/lib/linux/${lumen_runtime_arch}")
if(NOT lumen_resource_status EQUAL 0 OR
        NOT EXISTS "${lumen_runtime_dir}/libatomic.a" OR
        NOT EXISTS "${lumen_runtime_dir}/libunwind.a")
    message(FATAL_ERROR "Missing NDK Android atomic/unwind runtime: ${lumen_runtime_dir}")
endif()
foreach(kind EXE SHARED MODULE)
    string(FIND "${CMAKE_${kind}_LINKER_FLAGS}" "-L\"${lumen_runtime_dir}\"" lumen_runtime_flag)
    if(lumen_runtime_flag EQUAL -1)
        string(APPEND CMAKE_${kind}_LINKER_FLAGS " -L\"${lumen_runtime_dir}\"")
    endif()
endforeach()
set(CMAKE_C_COMPILER "${LUMEN_V8_COMPILER_DIR}/clang")
set(CMAKE_CXX_COMPILER "${LUMEN_V8_COMPILER_DIR}/clang++")
set(CMAKE_ASM_COMPILER "${CMAKE_C_COMPILER}")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES ANDROID_NDK CMAKE_ANDROID_NDK
    LUMEN_V8_DIR LUMEN_V8_COMPILER_DIR LUMEN_V8_PREBUILT_DIR)
