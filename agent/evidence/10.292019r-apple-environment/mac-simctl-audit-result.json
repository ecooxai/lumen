    "source": "#!/bin/bash\nDEVELOPER_USR_BIN_DIR=${0%/*}\nDEVELOPER_USR_BIN_DIR=${DEVELOPER_USR_BIN_DIR%/local/bin}\nDEVELOPER_USR_BIN_DIR=${DEVELOPER_USR_BIN_DIR%/bin}\nDEVELOPER_USR_BIN_DIR=${DEVELOPER_USR_BIN_DIR}/bin\nDEVELOPER_USR_DIR=${DEVELOPER_USR_BIN_DIR%/*}\nexport DEVELOPER_DIR=${DEVELOPER_USR_DIR%/*}\n\nEXPECTED_VERSION=\"1171.7\"\nCURRENT_VERSION=\"$(/usr/libexec/PlistBuddy -c \"Print :CFBundleVersion\" \"/Library/Developer/PrivateFrameworks/CoreSimulator.framework/Versions/A/Resources/Info.plist\" 2>/dev/null)\"\n\n# Canonicalize version by stripping trailing .0 components (e.g., 1107.0 -> 1107)\ncanonicalize_version() {\n    local v=\"$1\"\n    while [[ \"${v}\" =~ \\.0$ ]]; do\n        v=\"${v%.0}\"\n    done\n    printf '%s' \"${v}\"\n}\n\n# Returns 0 (true) if first version is older than second version\nversion_is_older() {\n    local v1=\"$(canonicalize_version \"$1\")\"\n    local v2=\"$(canonicalize_version \"$2\")\"\n    [[ \"$(printf '%s\\n%s\\n' \"${v1}\" \"${v2}\" | sort --version-sort | head -n1)\" == \"${v1}\" ]] && [[ \"${v1}\" != \"${v2}\" ]]\n}\n\n# Run FLE if current version is missing/empty or older than expected\nif [[ -z \"${CURRENT_VERSION}\" ]] || version_is_older \"${CURRENT_VERSION}\" \"${EXPECTED_VERSION}\"; then\n    \"${DEVELOPER_DIR}/usr/bin/xcodebuild\" -runFirstLaunch >&2\nfi\nexec \"/Library/Developer/PrivateFrameworks/CoreSimulator.framework/Versions/A/Resources/bin/simctl\" \"${@}\"\n"
  },
